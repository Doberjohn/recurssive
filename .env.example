# Contact form delivery. Without RESEND_API_KEY the form fails closed: it logs,
# sends the visitor to /contact/problem, and never claims the message was sent.
#
# Setup:
#   1. Create a Resend account and verify recurssive.com (their SPF + DKIM records).
#   2. Put the key here in .env.local for development, and in Vercel's
#      environment for preview + production.
#
# The From address must be on the verified domain. It is NOT the enquirer's
# address — sending as them fails SPF/DKIM and lands in spam. Their address goes
# in Reply-To, which the route sets automatically.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL="Recurssive site <noreply@recurssive.com>"
